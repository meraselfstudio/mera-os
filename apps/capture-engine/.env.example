# ============================================================
#  MÉRA CAPTURE ENGINE — Environment Configuration Template
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
# ============================================================

# Port the server listens on (leave as 3100)
PORT=3100

# Full path to your Capture One Sessions folder on the external drive
# To find the exact volume name, run: ls /Volumes/
SESSIONS_PATH=/Volumes/MERADATA/Capture One Session

# Full path to your Méra Exports folder on the external drive
EXPORTS_PATH=/Volumes/MERADATA/Méra Exports Photo Database

# DNP printer name as shown by CUPS
# To find this, run: lpstat -p
# Use the exact name shown (e.g. DNP_DS620 or DNP-DS-RX1)
PRINTER_NAME=DNP_DS620
