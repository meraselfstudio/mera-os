# ============================================================
# Méra SelfStudio 2.0 — Environment Variables Template
# Copy this to .env.local in each app and fill in real values.
# ============================================================

# Supabase — used by ALL apps
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# For Vite apps (POS Dashboard)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Edge Functions (server-side only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
